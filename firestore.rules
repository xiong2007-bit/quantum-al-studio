rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // Validation Helpers
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['name', 'email', 'derivAccountId', 'currency', 'country', 'joinDate', 'lastLogin'])
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.derivAccountId is string && data.derivAccountId.size() <= 50
        && data.currency is string && data.currency.size() <= 10
        && data.country is string && data.country.size() <= 100
        && data.joinDate is string && data.joinDate.size() <= 30
        && data.lastLogin is string && data.lastLogin.size() <= 30;
    }

    function isValidAccountBalance(data, userId) {
      return data.keys().hasAll(['balance', 'equity', 'margin', 'freeMargin', 'dailyPnL', 'weeklyPnL', 'monthlyPnL'])
        && data.balance is number
        && data.equity is number
        && data.margin is number
        && data.freeMargin is number
        && data.dailyPnL is number
        && data.weeklyPnL is number
        && data.monthlyPnL is number;
    }

    function isValidTradePosition(data, userId) {
      return data.keys().hasAll(['userId', 'symbol', 'displayName', 'action', 'entryPrice', 'currentPrice', 'stake', 'pnl', 'timestamp'])
        && data.userId == userId
        && data.symbol is string && data.symbol.size() <= 50
        && data.displayName is string && data.displayName.size() <= 100
        && data.action in ['BUY', 'SELL']
        && data.entryPrice is number
        && data.currentPrice is number
        && data.stake is number
        && data.pnl is number
        && data.timestamp is string && data.timestamp.size() <= 30;
    }

    function isValidTradeHistoryItem(data, userId) {
      return data.keys().hasAll(['userId', 'symbol', 'displayName', 'action', 'entryPrice', 'exitPrice', 'stake', 'pnl', 'result', 'timestamp'])
        && data.userId == userId
        && data.symbol is string && data.symbol.size() <= 50
        && data.displayName is string && data.displayName.size() <= 100
        && data.action in ['BUY', 'SELL']
        && data.entryPrice is number
        && data.exitPrice is number
        && data.stake is number
        && data.pnl is number
        && data.result in ['win', 'loss', 'refund']
        && data.timestamp is string && data.timestamp.size() <= 30;
    }

    function isValidJournalEntry(data, userId) {
      return data.keys().hasAll(['userId', 'timestamp', 'title', 'symbol', 'action', 'entryReason', 'exitReason', 'notes', 'performanceReview', 'pnl'])
        && data.userId == userId
        && data.timestamp is string && data.timestamp.size() <= 30
        && data.title is string && data.title.size() <= 200
        && data.symbol is string && data.symbol.size() <= 50
        && data.action in ['BUY', 'SELL']
        && data.entryReason is string && data.entryReason.size() <= 2000
        && data.exitReason is string && data.exitReason.size() <= 2000
        && (!data.keys().hasAny(['aiRecommendation']) || (data.aiRecommendation is string && data.aiRecommendation.size() <= 2000))
        && data.notes is string && data.notes.size() <= 5000
        && data.performanceReview in ['excellent', 'good', 'neutral', 'poor', 'terrible']
        && data.pnl is number;
    }

    function isValidSystemNotification(data, userId) {
      return data.keys().hasAll(['userId', 'timestamp', 'type', 'title', 'message', 'isRead'])
        && data.userId == userId
        && data.timestamp is string && data.timestamp.size() <= 30
        && data.type in ['success', 'warning', 'info', 'danger']
        && data.title is string && data.title.size() <= 200
        && data.message is string && data.message.size() <= 1000
        && data.isRead is bool;
    }

    // Collections
    match /users/{userId} {
      match /profile/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(docId) && isValidUserProfile(incoming(), userId) && incoming().keys().size() <= 20;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(docId) && isValidUserProfile(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }
      match /balance/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(docId) && isValidAccountBalance(incoming(), userId) && incoming().keys().size() <= 10;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(docId) && isValidAccountBalance(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }
      match /positions/{positionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(positionId);
        allow list: if isOwner(userId) && isValidId(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(positionId) && isValidTradePosition(incoming(), userId) && incoming().keys().size() <= 15;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(positionId) && isValidTradePosition(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(positionId);
      }
      match /history/{historyId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(historyId);
        allow list: if isOwner(userId) && isValidId(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(historyId) && isValidTradeHistoryItem(incoming(), userId) && incoming().keys().size() <= 15;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(historyId) && isValidTradeHistoryItem(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(historyId);
      }
      match /journals/{journalId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(journalId);
        allow list: if isOwner(userId) && isValidId(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(journalId) && isValidJournalEntry(incoming(), userId) && incoming().keys().size() <= 15;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(journalId) && isValidJournalEntry(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(journalId);
      }
      match /notifications/{notificationId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(notificationId);
        allow list: if isOwner(userId) && isValidId(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(notificationId) && isValidSystemNotification(incoming(), userId) && incoming().keys().size() <= 10;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(notificationId) && isValidSystemNotification(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(notificationId);
      }
    }
  }
}
